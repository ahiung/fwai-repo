{
    "name": "framework/ai",
    "description": "Slim 4 framework boilerplate with PHP-DI, Eloquent, and Twig",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "illuminate/database": "^10.0",
        "illuminate/pagination": "^10.0",
        "illuminate/events": "^10.0",
        "slim/twig-view": "^3.3",
        "slim/flash": "^0.4.0",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "slim/composer-merchant": true
        }
    }
}
