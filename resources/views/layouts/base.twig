<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token }}">
    <title>{% block title %}Dashboard{% endblock %} - Framework AI</title>

    <!-- Local Static Vendor Stylesheets -->
    <link rel="stylesheet" href="{{ base_path }}/assets/vendor/tailwind.min.css">
    <link rel="stylesheet" href="{{ base_path }}/assets/vendor/choices.min.css">
    <link rel="stylesheet" href="{{ base_path }}/assets/vendor/flatpickr.min.css">

    <!-- Google Fonts Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS Custom for Font Family, Scrollbars, Sidebar Transition and Overlay -->
    <style>
        :root {
            --forest-darkest: #16221f;     /* Deep spruce canopy */
            --forest-dark: #1d2c28;        /* Evergreen pine shadow */
            --forest-medium: #2e433c;      /* Moss & Juniper green */
            --forest-accent: #3d5a50;      /* Sage mist */
            --forest-light: #8fa89b;       /* Pale lichen green */
            --forest-mist: #eef3f0;        /* Soft Nordic morning mist */
            --nordic-fjord: #1f2d3d;       /* Icy fjord dark blue */
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f6f4; /* Soft Nordic morning mist background */
        }
        h1, h2, h3, h4, h5, h6, .font-display {
            font-family: 'Outfit', sans-serif;
        }

        /* Custom Scrollbar Styles */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: var(--forest-mist);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--forest-light);
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--forest-accent);
        }

        /* Main Sidebar Transition Controls */
        .main-sidebar {
            width: 280px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 40;
            background-color: var(--forest-darkest);
            transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-right: 1px solid var(--forest-medium);
        }

        .main-content {
            margin-left: 280px;
            min-height: 100vh;
            transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Premium custom classes for Nordic Forest theme */
        .sidebar-active {
            background: linear-gradient(to right, rgba(143, 168, 155, 0.18), rgba(46, 67, 60, 0.1)) !important;
            color: #ffffff !important;
            border-left: 4px solid var(--forest-light) !important;
            border-top-left-radius: 0px !important;
            border-bottom-left-radius: 0px !important;
            padding-left: 0.5rem !important;
        }
        
        .sidebar-icon-active {
            color: var(--forest-light) !important;
        }

        .bg-forest-gradient {
            background: linear-gradient(135deg, var(--forest-medium) 0%, var(--forest-dark) 100%) !important;
        }

        .btn-forest-primary {
            background: linear-gradient(135deg, var(--forest-medium) 0%, var(--forest-dark) 100%) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(29, 44, 40, 0.2) !important;
            transition: all 0.2s ease !important;
        }
        .btn-forest-primary:hover {
            background: linear-gradient(135deg, var(--forest-accent) 0%, var(--forest-medium) 100%) !important;
            box-shadow: 0 6px 16px rgba(29, 44, 40, 0.3) !important;
            transform: translateY(-1px) !important;
        }

        .btn-forest-secondary {
            background-color: #ffffff !important;
            color: var(--forest-dark) !important;
            border: 1px solid var(--forest-light) !important;
            transition: all 0.2s ease !important;
        }
        .btn-forest-secondary:hover {
            background-color: var(--forest-mist) !important;
            color: var(--forest-darkest) !important;
        }

        /* Global Input Focus Rings bertema Nordic Forest */
        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus,
        input[type="number"]:focus,
        textarea:focus,
        select:focus {
            border-color: var(--forest-light) !important;
            box-shadow: 0 0 0 3px rgba(143, 168, 155, 0.25) !important;
            outline: none !important;
        }

        /* Swiper / Choices.js adjustments */
        .choices__inner {
            border-radius: 1rem !important;
            border-color: #e5e7eb !important;
            background-color: #ffffff !important;
        }
        .choices__list--dropdown .choices__item--selectable.is-highlighted {
            background-color: var(--forest-mist) !important;
            color: var(--forest-darkest) !important;
        }

        /* Sidebar collapsed on Desktop screen */
        @media (min-width: 1024px) {
            body.sidebar-collapsed .main-sidebar {
                left: -280px;
            }
            body.sidebar-collapsed .main-content {
                margin-left: 0;
            }
        }

        /* Sidebar sliding on Mobile screen */
        @media (max-width: 1023px) {
            .main-sidebar {
                left: -280px;
            }
            .main-content {
                margin-left: 0;
            }
            body.sidebar-open .main-sidebar {
                left: 0;
            }
            body.sidebar-open .sidebar-overlay {
                display: block;
                opacity: 1;
            }
        }

        /* Responsive Mobile Blur Overlay */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 30;
            background-color: rgba(17, 24, 39, 0.4); /* gray-900 with alpha */
            backdrop-filter: blur(4px);
            transition: opacity 0.3s ease;
        }
    </style>
    {% block extra_styles %}{% endblock %}
</head>
<body class="antialiased text-gray-800">

    <!-- Mobile Sidebar Blur Overlay -->
    <div id="sidebar-overlay" class="sidebar-overlay"></div>

    <!-- Main Sidebar Container -->
    <aside class="main-sidebar flex flex-col justify-between shadow-2xl">
        <div>
            <!-- Sidebar Header Brand -->
            <div class="h-16 flex items-center px-6 border-b border-[var(--forest-medium)] justify-between">
                <a href="{{ base_path }}/dashboard" class="flex items-center space-x-3">
                    <!-- Brand Icon -->
                    <div class="h-8 w-8 rounded-xl bg-gradient-to-tr from-green-800 to-green-600 flex items-center justify-center shadow-lg shadow-green-900/20">
                        <span class="text-white font-bold font-display text-base">F</span>
                    </div>
                    <span class="text-white font-extrabold text-lg tracking-wider font-display">NORDIC<span class="text-[var(--forest-light)]">FOREST</span></span>
                </a>
            </div>

            <!-- Sidebar Navigation Menu -->
            <nav class="mt-6 px-4 space-y-1.5 flex-1">
                <!-- Navigation Header -->
                <span class="px-3 text-[10px] font-bold text-gray-500 uppercase tracking-widest block mb-2">MENU UTAMA</span>

                <a href="{{ base_path }}/dashboard" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition-colors duration-150 text-gray-300 hover:bg-[var(--forest-dark)] hover:text-white {% if current_route == 'dashboard' %} sidebar-active {% endif %}">
                    <svg class="h-5 w-5 {% if current_route == 'dashboard' %} sidebar-icon-active {% else %} text-gray-400 {% endif %}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2v-4zM14 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2v-4z" />
                    </svg>
                    <span>Dashboard</span>
                </a>

                <!-- IAM Section Header -->
                <span class="px-3 pt-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest block mb-2">AKSES & PENGGUNA</span>

                <a href="{{ base_path }}/users" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition-colors duration-150 text-gray-300 hover:bg-[var(--forest-dark)] hover:text-white {% if current_route == 'users' %} sidebar-active {% endif %}">
                    <svg class="h-5 w-5 {% if current_route == 'users' %} sidebar-icon-active {% else %} text-gray-400 {% endif %}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    <span>Manajemen User</span>
                </a>

                <a href="{{ base_path }}/roles" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition-colors duration-150 text-gray-300 hover:bg-[var(--forest-dark)] hover:text-white {% if current_route == 'roles' %} sidebar-active {% endif %}">
                    <svg class="h-5 w-5 {% if current_route == 'roles' %} sidebar-icon-active {% else %} text-gray-400 {% endif %}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <span>Peran & Akses</span>
                </a>

                <!-- Operational Section Header -->
                <span class="px-3 pt-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest block mb-2">OPERASIONAL KANTOR</span>

                <a href="{{ base_path }}/kantor-cabang" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition-colors duration-150 text-gray-300 hover:bg-[var(--forest-dark)] hover:text-white {% if current_route == 'kantor_cabang' %} sidebar-active {% endif %}">
                    <svg class="h-5 w-5 {% if current_route == 'kantor_cabang' %} sidebar-icon-active {% else %} text-gray-400 {% endif %}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    <span>Kantor Cabang</span>
                </a>

                <!-- Logs Section Header -->
                <span class="px-3 pt-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest block mb-2">AUDIT SYSTEM</span>

                <a href="{{ base_path }}/audit-trails" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition-colors duration-150 text-gray-300 hover:bg-[var(--forest-dark)] hover:text-white {% if current_route == 'audit_trails' %} sidebar-active {% endif %}">
                    <svg class="h-5 w-5 {% if current_route == 'audit_trails' %} sidebar-icon-active {% else %} text-gray-400 {% endif %}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Audit Trail</span>
                </a>
            </nav>
        </div>

        <!-- Sidebar Footer -->
        <div class="p-4 border-t border-[var(--forest-medium)] flex flex-col items-center">
            <span class="text-xs text-gray-500">Nordic Forest AI v1.0.0</span>
        </div>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="main-content flex flex-col">
        <!-- Top Navbar Header -->
        <header class="h-16 bg-white border-b border-gray-100 flex items-center justify-between px-6 sticky top-0 z-30">
            <!-- Left Side: Toggle Sidebar & Dynamic Breadcrumb -->
            <div class="flex items-center space-x-4">
                <button type="button" id="sidebar-toggle-btn" class="p-2 rounded-xl hover:bg-gray-50 text-gray-500 focus:outline-none transition-colors duration-150" aria-label="Toggle Sidebar">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                    </svg>
                </button>
                <div class="text-sm font-medium text-gray-500 select-none">
                    {% block breadcrumbs %}
                        <span class="hover:text-[var(--forest-accent)] transition-colors">Utama</span> / <span class="text-gray-800 font-semibold font-display">Dashboard</span>
                    {% endblock %}
                </div>
            </div>

            <!-- Right Side: Interactive User Dropdown -->
            <div class="relative" id="profile-dropdown-container">
                <button type="button" id="profile-dropdown-btn" class="flex items-center space-x-3 focus:outline-none hover:bg-gray-50 rounded-2xl p-1.5 transition-colors duration-150">
                    <div class="h-9 w-9 rounded-full bg-forest-gradient text-white flex items-center justify-center font-bold text-sm shadow-md font-display">
                        {{ (session.user.name | default('Admin User')) | slice(0, 2) | upper }}
                    </div>
                    <div class="hidden md:flex flex-col text-left mr-2 select-none">
                        <span class="text-sm font-bold text-gray-700 leading-none">{{ session.user.name|default('Administrator') }}</span>
                        <span class="text-[10px] text-gray-400 mt-1 uppercase tracking-wider font-semibold">{{ session.user.role_name|default('Superadmin') }}</span>
                    </div>
                    <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                <!-- Profile Dropdown Menu Panel -->
                <div id="profile-dropdown-menu" class="hidden absolute right-0 mt-2.5 w-64 bg-white rounded-2xl shadow-2xl border border-gray-100 py-3 z-50 transition-all duration-200">
                    <div class="px-4 py-3 border-b border-gray-100 flex items-center space-x-3">
                        <div class="h-12 w-12 rounded-full bg-forest-gradient text-white flex items-center justify-center font-bold text-lg shadow-md font-display">
                            {{ (session.user.name | default('Admin User')) | slice(0, 2) | upper }}
                        </div>
                        <div class="flex flex-col select-none">
                            <span class="text-sm font-bold text-gray-800 leading-none">{{ session.user.name|default('Administrator') }}</span>
                            <span class="text-[11px] text-gray-500 mt-1">{{ session.user.email|default('admin@framework.ai') }}</span>
                            <span class="text-[9px] bg-[var(--forest-mist)] text-[var(--forest-dark)] px-2 py-0.5 rounded-full font-bold mt-1.5 w-max uppercase tracking-wider">{{ session.user.role_name|default('Superadmin') }}</span>
                        </div>
                    </div>
                    
                    <div class="p-1.5 space-y-0.5">
                        <a href="{{ base_path }}/profile" class="flex items-center space-x-3 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[var(--forest-medium)] rounded-xl transition-colors">
                            <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            <span class="font-medium">Profil Saya</span>
                        </a>
                        
                        <a href="{{ base_path }}/settings" class="flex items-center space-x-3 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[var(--forest-medium)] rounded-xl transition-colors">
                            <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span class="font-medium">Pengaturan</span>
                        </a>
                    </div>
                    
                    <div class="border-t border-gray-100 my-1"></div>
                    
                    <div class="p-1.5">
                        <a href="{{ base_path }}/logout" class="flex items-center space-x-3 px-3 py-2 text-sm text-red-600 hover:bg-red-50 rounded-xl transition-colors">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            <span class="font-semibold">Keluar</span>
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Body Content Block -->
        <main class="flex-1 p-6">
            {% block content %}
                <!-- Default dashboard page if not overridden -->
                <div class="bg-white rounded-3xl border border-gray-100 p-8 shadow-sm">
                    <h1 class="text-2xl font-bold text-gray-800">Selamat Datang di Framework AI</h1>
                    <p class="text-gray-500 mt-2">Ini adalah sistem template utama yang siap digunakan.</p>
                </div>
            {% endblock %}
        </main>
    </div>

    <!-- Local Static Vendor Scripts -->
    <script src="{{ base_path }}/assets/vendor/sweetalert2.all.min.js"></script>
    <script src="{{ base_path }}/assets/vendor/choices.min.js"></script>
    <script src="{{ base_path }}/assets/vendor/flatpickr.min.js"></script>
    <script src="{{ base_path }}/assets/vendor/axios.min.js"></script>
    
    <!-- Custom Application Script -->
    <script src="{{ base_path }}/assets/js/app.js"></script>

    <!-- Interactive JS Logic for Sidebar and Dropdown Toggles -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Profile dropdown panel triggers
            const profileBtn = document.getElementById('profile-dropdown-btn');
            const profileMenu = document.getElementById('profile-dropdown-menu');

            if (profileBtn && profileMenu) {
                profileBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    profileMenu.classList.toggle('hidden');
                });

                document.addEventListener('click', (e) => {
                    if (!profileMenu.contains(e.target) && !profileBtn.contains(e.target)) {
                        profileMenu.classList.add('hidden');
                    }
                });
            }

            // Sidebar navigation panel triggers
            const sidebarBtn = document.getElementById('sidebar-toggle-btn');
            const sidebarOverlay = document.getElementById('sidebar-overlay');

            if (sidebarBtn) {
                sidebarBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (window.innerWidth >= 1024) {
                        document.body.classList.toggle('sidebar-collapsed');
                    } else {
                        document.body.classList.toggle('sidebar-open');
                    }
                });
            }

            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', () => {
                    document.body.classList.remove('sidebar-open');
                });
            }
        });
    </script>

    <!-- Slim Flash Message Toast Triggers using SweetAlert2 -->
    {% set successFlash = flash.getMessage('success') %}
    {% if successFlash is not empty %}
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: "{{ successFlash[0] }}",
                        showConfirmButton: false,
                        timer: 3500,
                        timerProgressBar: true
                    });
                }
            });
        </script>
    {% endif %}

    {% set errorFlash = flash.getMessage('error') %}
    {% if errorFlash is not empty %}
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: "{{ errorFlash[0] }}",
                        showConfirmButton: false,
                        timer: 4500,
                        timerProgressBar: true
                    });
                }
            });
        </script>
    {% endif %}

    {% block extra_scripts %}{% endblock %}
</body>
</html>
