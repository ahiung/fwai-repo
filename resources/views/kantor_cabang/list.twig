{% extends 'layouts/base.twig' %}

{% block title %}Manajemen Kantor Cabang{% endblock %}

{% block breadcrumbs %}
    <a href="{{ base_path }}/dashboard" class="text-gray-400 hover:text-[var(--forest-accent)] transition-colors select-none">Utama</a> 
    <span class="text-gray-300">/</span> 
    <span class="text-gray-800 font-semibold font-display select-none">Kantor Cabang</span>
{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Action Header -->
    <div class="bg-white rounded-3xl border border-gray-100 p-6 shadow-sm flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 select-none">
        <div>
            <h2 class="text-xl font-bold text-gray-900 font-display">Daftar Kantor Cabang</h2>
            <p class="text-xs text-gray-400 mt-1">Kelola data kantor cabang, tipe operasional, lokasi, koordinat presisi, serta pimpinan kantor.</p>
        </div>
        {% if can('add_kantor_cabang') %}
            <a href="{{ base_path }}/kantor-cabang/add" class="inline-flex items-center space-x-2 btn-forest-primary py-2.5 px-5 rounded-2xl shadow-md hover:shadow-lg focus:outline-none transition-all text-xs tracking-wide">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <span>Tambah Kantor</span>
            </a>
        {% endif %}
    </div>

    <!-- Table Grid Content -->
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-100 text-gray-400 font-semibold uppercase text-[10px] tracking-wider select-none">
                        <th class="py-4 px-6">Kantor Cabang</th>
                        <th class="py-4 px-6">Tipe</th>
                        <th class="py-4 px-6">Pimpinan (Manager)</th>
                        <th class="py-4 px-6">Kontak & Kota</th>
                        <th class="py-4 px-6">Status</th>
                        <th class="py-4 px-6 text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for office in offices %}
                        <tr class="hover:bg-gray-50/50 transition-colors">
                            <td class="py-4 px-6 flex items-center space-x-3">
                                <div class="h-10 w-10 rounded-2xl bg-[var(--forest-mist)] text-[var(--forest-medium)] flex items-center justify-center font-bold text-sm font-display select-none border border-[var(--forest-light)]/20">
                                    {{ office.name | slice(0, 2) | upper }}
                                </div>
                                <div>
                                    <a href="{{ base_path }}/kantor-cabang/view/{{ office.id }}" class="font-bold text-gray-900 block font-display hover:text-[var(--forest-medium)] transition-colors">{{ office.name }}</a>
                                    <span class="text-[10px] text-gray-400 font-semibold uppercase tracking-wider">{{ office.office_code }}</span>
                                </div>
                            </td>
                            <td class="py-4 px-6">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide border select-none 
                                    {% if office.office_type == 'head' %} bg-purple-50 text-purple-700 border-purple-200 
                                    {% elseif office.office_type == 'branch' %} bg-blue-50 text-blue-700 border-blue-200 
                                    {% else %} bg-yellow-50 text-yellow-700 border-yellow-200 {% endif %}">
                                    {{ office.office_type }}
                                </span>
                            </td>
                            <td class="py-4 px-6 font-semibold text-gray-700">
                                {% if office.manager %}
                                    <div class="flex flex-col">
                                        <span class="text-sm font-semibold text-gray-800">{{ office.manager.name }}</span>
                                        <span class="text-[10px] text-gray-400 font-medium">{{ office.manager.email }}</span>
                                    </div>
                                {% else %}
                                    <span class="text-xs text-gray-400 italic">Belum ditentukan</span>
                                {% endif %}
                            </td>
                            <td class="py-4 px-6">
                                <div class="text-gray-500 font-medium">
                                    {{ office.city | default('-') }}, {{ office.province | default('-') }}
                                </div>
                                <div class="text-[10px] text-gray-400">
                                    {{ office.phone | default('Tidak ada telepon') }}
                                </div>
                            </td>
                            <td class="py-4 px-6">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold {% if office.status == 'active' %} bg-green-50 text-green-700 border-green-200 {% else %} bg-red-50 text-red-700 border-red-200 {% endif %} uppercase tracking-wide border select-none">
                                    {{ office.status == 'active' ? 'Aktif' : 'Nonaktif' }}
                                </span>
                            </td>
                            <td class="py-4 px-6 text-right">
                                <div class="flex items-center justify-end space-x-1">
                                    <a href="{{ base_path }}/kantor-cabang/view/{{ office.id }}" class="p-2 rounded-xl text-gray-500 hover:bg-[var(--forest-mist)] hover:text-[var(--forest-medium)] transition-all" title="Detail Kantor Cabang">
                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                    </a>
                                    {% if can('edit_kantor_cabang') %}
                                        <a href="{{ base_path }}/kantor-cabang/edit/{{ office.id }}" class="p-2 rounded-xl text-gray-500 hover:bg-[var(--forest-mist)] hover:text-[var(--forest-medium)] transition-all" title="Ubah Kantor Cabang">
                                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                            </svg>
                                        </a>
                                    {% endif %}
                                    {% if can('delete_kantor_cabang') %}
                                        <a href="{{ base_path }}/kantor-cabang/delete/{{ office.id }}" 
                                           onclick="return confirm('Apakah Anda yakin ingin menghapus kantor cabang ini?');"
                                           class="p-2 rounded-xl text-gray-500 hover:bg-red-50 hover:text-red-600 transition-all" title="Hapus Kantor Cabang">
                                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </a>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-12 px-6 text-center text-gray-400 font-semibold">
                                Belum ada data kantor cabang terdaftar atau Anda tidak memiliki akses ke data kantor cabang manapun.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Dynamic Responsive Pagination Controls -->
        {% if paginator.hasPages() %}
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-between">
                <!-- Mobile Prev/Next -->
                <div class="flex-1 flex justify-between sm:hidden">
                    {% if paginator.onFirstPage() %}
                        <span class="px-4 py-2 border border-gray-200 rounded-xl text-xs font-bold text-gray-300 bg-white select-none">Sebelumnya</span>
                    {% else %}
                        <a href="{{ paginator.previousPageUrl() }}" onclick="window.showLoading()" class="px-4 py-2 border border-gray-200 rounded-xl text-xs font-bold text-gray-600 bg-white hover:bg-gray-50 transition-all">Sebelumnya</a>
                    {% endif %}

                    {% if paginator.hasMorePages() %}
                        <a href="{{ paginator.nextPageUrl() }}" onclick="window.showLoading()" class="px-4 py-2 border border-gray-200 rounded-xl text-xs font-bold text-gray-600 bg-white hover:bg-gray-50 transition-all">Selanjutnya</a>
                    {% else %}
                        <span class="px-4 py-2 border border-gray-200 rounded-xl text-xs font-bold text-gray-300 bg-white select-none">Selanjutnya</span>
                    {% endif %}
                </div>

                <!-- Desktop Details -->
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between select-none">
                    <div>
                        <p class="text-xs text-gray-400">
                            Menampilkan <span class="font-bold text-gray-700">{{ paginator.firstItem() }}</span> hingga <span class="font-bold text-gray-700">{{ paginator.lastItem() }}</span> dari <span class="font-bold text-gray-700">{{ paginator.total() }}</span> data
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-xl shadow-sm -space-x-px" aria-label="Pagination">
                            <!-- Prev -->
                            {% if paginator.onFirstPage() %}
                                <span class="relative inline-flex items-center px-3 py-2 rounded-l-xl border border-gray-200 bg-white text-xs font-bold text-gray-300 select-none">
                                    &lsaquo;
                                </span>
                            {% else %}
                                <a href="{{ paginator.previousPageUrl() }}" onclick="window.showLoading()" class="relative inline-flex items-center px-3 py-2 rounded-l-xl border border-gray-200 bg-white text-xs font-bold text-gray-500 hover:bg-gray-50 transition-all">
                                    &lsaquo;
                                </a>
                            {% endif %}

                            <!-- Page Numbers -->
                            {% for i in 1..paginator.lastPage() %}
                                {% if i == paginator.currentPage() %}
                                    <span class="z-10 bg-[var(--forest-mist)] border-[var(--forest-light)] text-[var(--forest-medium)] relative inline-flex items-center px-3.5 py-2 border text-xs font-bold">
                                        {{ i }}
                                    </span>
                                {% else %}
                                    <a href="{{ paginator.url(i) }}" onclick="window.showLoading()" class="bg-white border-gray-200 text-gray-500 hover:bg-gray-50 relative inline-flex items-center px-3.5 py-2 border text-xs font-bold transition-all">
                                        {{ i }}
                                    </a>
                                {% endif %}
                            {% endfor %}

                            <!-- Next -->
                            {% if paginator.hasMorePages() %}
                                <a href="{{ paginator.nextPageUrl() }}" onclick="window.showLoading()" class="relative inline-flex items-center px-3 py-2 rounded-r-xl border border-gray-200 bg-white text-xs font-bold text-gray-500 hover:bg-gray-50 transition-all">
                                    &rsaquo;
                                </a>
                            {% else %}
                                <span class="relative inline-flex items-center px-3 py-2 rounded-r-xl border border-gray-200 bg-white text-xs font-bold text-gray-300 select-none">
                                    &rsaquo;
                                </span>
                            {% endif %}
                        </nav>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
