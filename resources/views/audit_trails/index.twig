{% extends 'layouts/base.twig' %}

{% block title %}Audit Trail Log{% endblock %}

{% block breadcrumbs %}
    <a href="{{ base_path }}/dashboard" class="text-gray-400 hover:text-[var(--forest-accent)] transition-colors select-none">Utama</a> 
    <span class="text-gray-300">/</span> 
    <span class="text-gray-800 font-semibold font-display select-none">Audit Trail Log</span>
{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Header Summary -->
    <div class="bg-white rounded-3xl border border-gray-100 p-6 shadow-sm select-none">
        <h2 class="text-xl font-bold text-gray-900 font-display">Log Aktivitas Sistem (Audit Trail)</h2>
        <p class="text-xs text-gray-400 mt-1">Daftar rekaman perubahan data operasional CUD (Create, Update, Delete) dan status keamanan.</p>
    </div>

    <!-- Table Grid -->
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-100 text-gray-400 font-semibold uppercase text-[10px] tracking-wider select-none">
                        <th class="py-4 px-6">Identitas User</th>
                        <th class="py-4 px-6">Tindakan</th>
                        <th class="py-4 px-6">Modul</th>
                        <th class="py-4 px-6">Deskripsi Log</th>
                        <th class="py-4 px-6">Alamat IP</th>
                        <th class="py-4 px-6">Waktu Pencatatan (WIB)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for log in logs %}
                        <tr class="hover:bg-gray-50/50 transition-colors">
                            <td class="py-4 px-6 font-semibold text-gray-700">
                                {{ log.user ? log.user.name : 'Sistem / Anonim' }}
                                <span class="block text-[10px] text-gray-400 font-normal mt-0.5">@{{ log.user ? log.user.username : 'system_agent' }}</span>
                            </td>
                            <td class="py-4 px-6">
                                {% if log.action in ['CREATE', 'LOGIN_SUCCESS', 'STORE'] %}
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[9px] font-bold bg-green-50 text-green-600 uppercase tracking-wide select-none">
                                        {{ log.action }}
                                    </span>
                                {% elseif log.action in ['UPDATE', 'EDIT'] %}
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[9px] font-bold bg-yellow-50 text-yellow-600 uppercase tracking-wide select-none">
                                        {{ log.action }}
                                    </span>
                                {% elseif log.action in ['DELETE', 'LOGIN_FAILED', 'LOGOUT'] %}
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[9px] font-bold bg-red-50 text-red-600 uppercase tracking-wide select-none">
                                        {{ log.action }}
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[9px] font-bold bg-gray-50 text-gray-600 uppercase tracking-wide select-none">
                                        {{ log.action }}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="py-4 px-6 text-gray-500 font-semibold text-xs font-mono">
                                {{ log.module }}
                            </td>
                            <td class="py-4 px-6 text-gray-500 text-xs leading-normal max-w-sm" title="{{ log.description }}">
                                {{ log.description }}
                            </td>
                            <td class="py-4 px-6 text-gray-400 font-mono text-xs">
                                {{ log.ip_address }}
                            </td>
                            <td class="py-4 px-6 text-gray-400 font-medium">
                                {{ format_tanggal(log.created_at) }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-12 px-6 text-center text-gray-400 font-semibold">
                                Belum ada log aktivitas audit trail tercatat di database.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Responsive Pagination Controls -->
        {% if paginator.hasPages() %}
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-between">
                <!-- Mobile Navigation -->
                <div class="flex-1 flex justify-between sm:hidden">
                    {% if paginator.onFirstPage() %}
                        <span class="px-4 py-2 border border-gray-200 rounded-xl text-xs font-bold text-gray-300 bg-white select-none">Sebelumnya</span>
                    {% else %}
                        <a href="{{ paginator.previousPageUrl() }}" onclick="window.showLoading()" class="px-4 py-2 border border-gray-200 rounded-xl text-xs font-bold text-gray-600 bg-white hover:bg-gray-50 transition-all">Sebelumnya</a>
                    {% endif %}

                    {% if paginator.hasMorePages() %}
                        <a href="{{ paginator.nextPageUrl() }}" onclick="window.showLoading()" class="px-4 py-2 border border-gray-200 rounded-xl text-xs font-bold text-gray-600 bg-white hover:bg-gray-50 transition-all">Selanjutnya</a>
                    {% else %}
                        <span class="px-4 py-2 border border-gray-200 rounded-xl text-xs font-bold text-gray-300 bg-white select-none">Selanjutnya</span>
                    {% endif %}
                </div>

                <!-- Desktop Navigation -->
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between select-none">
                    <div>
                        <p class="text-xs text-gray-400">
                            Menampilkan <span class="font-bold text-gray-700">{{ paginator.firstItem() }}</span> hingga <span class="font-bold text-gray-700">{{ paginator.lastItem() }}</span> dari <span class="font-bold text-gray-700">{{ paginator.total() }}</span> data log
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-xl shadow-sm -space-x-px" aria-label="Pagination">
                            <!-- Prev -->
                            {% if paginator.onFirstPage() %}
                                <span class="relative inline-flex items-center px-3 py-2 rounded-l-xl border border-gray-200 bg-white text-xs font-bold text-gray-300 select-none">
                                    &lsaquo;
                                </span>
                            {% else %}
                                <a href="{{ paginator.previousPageUrl() }}" onclick="window.showLoading()" class="relative inline-flex items-center px-3 py-2 rounded-l-xl border border-gray-200 bg-white text-xs font-bold text-gray-500 hover:bg-gray-50 transition-all">
                                    &lsaquo;
                                </a>
                            {% endif %}

                            <!-- Page Numbers -->
                            {% for i in 1..paginator.lastPage() %}
                                {% if i == paginator.currentPage() %}
                                    <span class="z-10 bg-[var(--forest-mist)] border-[var(--forest-light)] text-[var(--forest-medium)] relative inline-flex items-center px-3.5 py-2 border text-xs font-bold">
                                        {{ i }}
                                    </span>
                                {% else %}
                                    <a href="{{ paginator.url(i) }}" onclick="window.showLoading()" class="bg-white border-gray-200 text-gray-500 hover:bg-gray-50 relative inline-flex items-center px-3.5 py-2 border text-xs font-bold transition-all">
                                        {{ i }}
                                    </a>
                                {% endif %}
                            {% endfor %}

                            <!-- Next -->
                            {% if paginator.hasMorePages() %}
                                <a href="{{ paginator.nextPageUrl() }}" onclick="window.showLoading()" class="relative inline-flex items-center px-3 py-2 rounded-r-xl border border-gray-200 bg-white text-xs font-bold text-gray-500 hover:bg-gray-50 transition-all">
                                    &rsaquo;
                                </a>
                            {% else %}
                                <span class="relative inline-flex items-center px-3 py-2 rounded-r-xl border border-gray-200 bg-white text-xs font-bold text-gray-300 select-none">
                                    &rsaquo;
                                </span>
                            {% endif %}
                        </nav>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
