{% extends 'layouts/base.twig' %}

{% block title %}Tambah User Baru{% endblock %}

{% block breadcrumbs %}
    <a href="{{ base_path }}/dashboard" class="text-gray-400 hover:text-[var(--forest-accent)] transition-colors select-none">Utama</a> 
    <span class="text-gray-300">/</span> 
    <a href="{{ base_path }}/users" class="text-gray-400 hover:text-[var(--forest-accent)] transition-colors select-none">Manajemen User</a> 
    <span class="text-gray-300">/</span> 
    <span class="text-gray-800 font-semibold font-display select-none">Tambah User</span>
{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto">
    <form action="{{ base_path }}/users/add" method="POST" autocomplete="off" class="space-y-6">
        <!-- Main Card -->
        <div class="bg-white rounded-3xl border border-gray-100 p-6 shadow-sm space-y-5">
            <h3 class="font-bold text-gray-900 font-display text-base border-b border-gray-50 pb-3">Informasi Akun User</h3>

            <!-- Username Input -->
            <div>
                <label for="username" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Username</label>
                <input type="text" name="username" id="username" value="{{ old.username }}" required
                       class="w-full px-4 py-3 rounded-2xl border border-gray-200 focus:outline-none text-sm transition-all text-gray-800"
                       placeholder="Masukkan username unik">
                {% if errors.username %}
                    <p class="text-red-500 text-xs mt-1.5 font-semibold flex items-center">
                        <svg class="h-3.5 w-3.5 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                        {{ errors.username }}
                    </p>
                {% endif %}
            </div>

            <!-- Email Input -->
            <div>
                <label for="email" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Alamat Email</label>
                <input type="email" name="email" id="email" value="{{ old.email }}" required
                       class="w-full px-4 py-3 rounded-2xl border border-gray-200 focus:outline-none text-sm transition-all text-gray-800"
                       placeholder="nama@email.com">
                {% if errors.email %}
                    <p class="text-red-500 text-xs mt-1.5 font-semibold flex items-center">
                        <svg class="h-3.5 w-3.5 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                        {{ errors.email }}
                    </p>
                {% endif %}
            </div>

            <!-- Name Input -->
            <div>
                <label for="name" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Nama Lengkap</label>
                <input type="text" name="name" id="name" value="{{ old.name }}" required
                       class="w-full px-4 py-3 rounded-2xl border border-gray-200 focus:outline-none text-sm transition-all text-gray-800"
                       placeholder="Masukkan nama lengkap pengguna">
                {% if errors.name %}
                    <p class="text-red-500 text-xs mt-1.5 font-semibold flex items-center">
                        <svg class="h-3.5 w-3.5 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                        {{ errors.name }}
                    </p>
                {% endif %}
            </div>

            <!-- Role Input (Using Choices.js) -->
            <div>
                <label for="role_id" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Peran Akses (Role)</label>
                <select name="role_id" id="role_id" required class="w-full">
                    <option value="">Pilih Peran...</option>
                    {% for role in roles %}
                        <option value="{{ role.id }}" {% if old.role_id == role.id %} selected {% endif %}>{{ role.name }} - {{ role.description }}</option>
                    {% endfor %}
                </select>
                {% if errors.role_id %}
                    <p class="text-red-500 text-xs mt-1.5 font-semibold flex items-center">
                        <svg class="h-3.5 w-3.5 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                        {{ errors.role_id }}
                    </p>
                {% endif %}
            </div>

            <!-- Password Input -->
            <div>
                <label for="password" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Password Akun</label>
                <input type="password" name="password" id="password" required
                       class="w-full px-4 py-3 rounded-2xl border border-gray-200 focus:outline-none text-sm transition-all text-gray-800"
                       placeholder="Minimal 6 karakter">
                {% if errors.password %}
                    <p class="text-red-500 text-xs mt-1.5 font-semibold flex items-center">
                        <svg class="h-3.5 w-3.5 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                        {{ errors.password }}
                    </p>
                {% endif %}
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center justify-end space-x-3 select-none">
            <a href="{{ base_path }}/users" class="px-5 py-2.5 rounded-2xl border border-gray-200 text-gray-500 hover:bg-gray-50 text-xs font-bold transition-all">
                Batal
            </a>
            <button type="submit"
                    class="btn-forest-primary py-2.5 px-6 rounded-2xl shadow-md hover:shadow-lg focus:outline-none transition-all text-xs tracking-wide">
                Simpan User
            </button>
        </div>
    </form>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Initialize Choices.js on role selection field
        const selectRole = document.getElementById('role_id');
        if (selectRole && typeof Choices !== 'undefined') {
            new Choices(selectRole, {
                searchEnabled: false,
                itemSelectText: '',
                shouldSort: false,
                removeItemButton: false
            });
        }
    });
</script>
{% endblock %}
